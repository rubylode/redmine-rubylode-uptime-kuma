<% current_settings = RubylodeUptimeKuma::Settings.new(settings) %>
<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-uptime-kuma-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_uptime_kuma.settings" %>
<% text_value = ->(key) { settings[key].nil? ? RubylodeUptimeKuma::Settings::DEFAULTS[key] : settings[key] } %>

<p>
  <label for="settings_base_url"><%= l("#{scope}.base_url.label") %></label>
  <%= text_field_tag "settings[base_url]", text_value.call("base_url"), size: 60, id: "settings_base_url", placeholder: "https://uptime.example.com" %>
  <em class="info"><%= l("#{scope}.base_url.hint") %></em>
</p>

<p>
  <label for="settings_token_environment_variable"><%= l("#{scope}.token_environment_variable.label") %></label>
  <%= text_field_tag "settings[token_environment_variable]", text_value.call("token_environment_variable"), size: 30, id: "settings_token_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.token_environment_variable.hint") %>
    <strong><%= current_settings.token.empty? ? l("#{scope}.token_environment_variable.is_not_set") : l("#{scope}.token_environment_variable.is_set") %></strong>
  </em>
</p>

<p>
  <label for="settings_allowed_hosts"><%= l("#{scope}.allowed_hosts.label") %></label>
  <%= text_field_tag "settings[allowed_hosts]", text_value.call("allowed_hosts"), size: 60, id: "settings_allowed_hosts" %>
  <em class="info"><%= l("#{scope}.allowed_hosts.hint") %></em>
</p>

<p>
  <label for="settings_allow_plain_http"><%= l("#{scope}.allow_plain_http.label") %></label>
  <%= hidden_field_tag "settings[allow_plain_http]", "0", id: nil %>
  <%= check_box_tag "settings[allow_plain_http]", "1", text_value.call("allow_plain_http").to_s == "1", id: "settings_allow_plain_http" %>
  <em class="info"><%= l("#{scope}.allow_plain_http.hint") %></em>
</p>

<p>
  <label for="settings_services"><%= l("#{scope}.services.label") %></label>
  <%= text_area_tag "settings[services]", text_value.call("services"), rows: 10, cols: 90, id: "settings_services", class: "wiki-edit", placeholder: l("#{scope}.services.example") %>
  <em class="info"><%= l("#{scope}.services.hint") %></em>
</p>

<p>
  <label for="settings_dashboard_url"><%= l("#{scope}.dashboard_url.label") %></label>
  <%= text_field_tag "settings[dashboard_url]", text_value.call("dashboard_url"), size: 60, id: "settings_dashboard_url", placeholder: "https://uptime.example.com/dashboard" %>
  <em class="info"><%= l("#{scope}.dashboard_url.hint") %></em>
</p>

<p>
  <label for="settings_block_title"><%= l("#{scope}.block_title.label") %></label>
  <%= text_field_tag "settings[block_title]", text_value.call("block_title"), size: 30, id: "settings_block_title" %>
  <em class="info"><%= l("#{scope}.block_title.hint") %></em>
</p>

<p>
  <label for="settings_visibility"><%= l("#{scope}.visibility.label") %></label>
  <%= select_tag "settings[visibility]", options_for_select([[l("#{scope}.visibility.logged_in"), "logged_in"], [l("#{scope}.visibility.admins"), "admins"]], text_value.call("visibility")), id: "settings_visibility" %>
</p>

<fieldset class="rubylode-uptime-kuma-placements">
  <legend><%= l("#{scope}.show_on_heading") %></legend>
  <% column_select = lambda do |key|
       content_tag(:span, class: "rubylode-uptime-kuma-column") do
         label_tag("settings_#{key}", l("#{scope}.#{key}.label")) +
           select_tag("settings[#{key}]", options_for_select([[l("#{scope}.column_left"), "left"], [l("#{scope}.column_right"), "right"]], text_value.call(key)), id: "settings_#{key}")
       end
     end %>
  <p>
    <%= hidden_field_tag "settings[show_on_welcome_page]", "0", id: nil %>
    <label class="floating"><%= check_box_tag "settings[show_on_welcome_page]", "1", text_value.call("show_on_welcome_page").to_s == "1", id: "settings_show_on_welcome_page" %> <%= l("#{scope}.show_on_welcome_page.label") %></label>
    <%= column_select.call("welcome_page_column") %>
    <em class="info"><%= l("#{scope}.show_on_welcome_page.hint") %></em>
  </p>
  <p>
    <%= hidden_field_tag "settings[show_on_my_page]", "0", id: nil %>
    <label class="floating"><%= check_box_tag "settings[show_on_my_page]", "1", text_value.call("show_on_my_page").to_s == "1", id: "settings_show_on_my_page" %> <%= l("#{scope}.show_on_my_page.label") %></label>
    <em class="info"><%= l("#{scope}.show_on_my_page.hint") %></em>
  </p>
  <p>
    <%= hidden_field_tag "settings[show_on_project_overview]", "0", id: nil %>
    <label class="floating"><%= check_box_tag "settings[show_on_project_overview]", "1", text_value.call("show_on_project_overview").to_s == "1", id: "settings_show_on_project_overview" %> <%= l("#{scope}.show_on_project_overview.label") %></label>
    <%= column_select.call("project_overview_column") %>
    <em class="info"><%= l("#{scope}.show_on_project_overview.hint") %></em>
  </p>
  <p>
    <%= hidden_field_tag "settings[show_on_matching_pages]", "0", id: nil %>
    <label class="floating"><%= check_box_tag "settings[show_on_matching_pages]", "1", text_value.call("show_on_matching_pages").to_s == "1", id: "settings_show_on_matching_pages" %> <%= l("#{scope}.show_on_matching_pages.label") %></label>
    <em class="info"><%= l("#{scope}.show_on_matching_pages.hint") %></em>
  </p>
  <p>
    <%= text_area_tag "settings[matching_page_paths]", text_value.call("matching_page_paths"), rows: 3, cols: 50, id: "settings_matching_page_paths", placeholder: "/issues\n/projects/*/issues", title: l("#{scope}.matching_page_paths.label") %>
    <em class="info"><%= l("#{scope}.matching_page_paths.hint") %></em>
  </p>
  <% if RubylodeUptimeKuma::Settings.status_plugin_installed? %>
    <%= hidden_field_tag "settings[show_in_top_menu]", text_value.call("show_in_top_menu"), id: nil %>
  <% else %>
    <p>
      <%= hidden_field_tag "settings[show_in_top_menu]", "0", id: nil %>
      <label class="floating"><%= check_box_tag "settings[show_in_top_menu]", "1", text_value.call("show_in_top_menu").to_s == "1", id: "settings_show_in_top_menu" %> <%= l("#{scope}.show_in_top_menu.label") %></label>
      <em class="info"><%= l("#{scope}.show_in_top_menu.hint") %></em>
    </p>
  <% end %>
</fieldset>

<p>
  <label for="settings_show_response_time"><%= l("#{scope}.show_response_time.label") %></label>
  <%= hidden_field_tag "settings[show_response_time]", "0", id: nil %>
  <%= check_box_tag "settings[show_response_time]", "1", text_value.call("show_response_time").to_s == "1", id: "settings_show_response_time" %>
</p>

<p>
  <label for="settings_cache_seconds"><%= l("#{scope}.cache_seconds.label") %></label>
  <%= number_field_tag "settings[cache_seconds]", text_value.call("cache_seconds"), min: 0, size: 6, id: "settings_cache_seconds" %>
  <em class="info"><%= l("#{scope}.cache_seconds.hint") %></em>
</p>

<p>
  <label for="settings_failure_cache_seconds"><%= l("#{scope}.failure_cache_seconds.label") %></label>
  <%= number_field_tag "settings[failure_cache_seconds]", text_value.call("failure_cache_seconds"), min: 0, size: 6, id: "settings_failure_cache_seconds" %>
  <em class="info"><%= l("#{scope}.failure_cache_seconds.hint") %></em>
</p>

<p>
  <label for="settings_timeout_seconds"><%= l("#{scope}.timeout_seconds.label") %></label>
  <%= number_field_tag "settings[timeout_seconds]", text_value.call("timeout_seconds"), min: 1, size: 6, id: "settings_timeout_seconds" %>
  <em class="info"><%= l("#{scope}.timeout_seconds.hint") %></em>
</p>

<%= render partial: "rubylode_uptime_kuma/status_plugin_notice" %>

<%= render partial: "settings/rubylode_uptime_kuma_help" %>
