<%# The same two sentences in every Rubylode plugin: whether the Status plugin is there to show this block with the others. %>
<p class="rubylode-status-notice">
  <% if RubylodeUptimeKuma::Settings.status_plugin_installed? %>
    <%= t("rubylode_uptime_kuma.status_plugin.installed_html", link: link_to(t("rubylode_uptime_kuma.status_plugin.status_page"), "/status")) %>
  <% else %>
    <%= t("rubylode_uptime_kuma.status_plugin.missing_html", link: link_to("Rubylode Status", "https://github.com/rubylode/redmine-rubylode-status")) %>
  <% end %>
</p>
